# Local development uses Spring Boot's standard datasource variables.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55432/policyinsight
SPRING_DATASOURCE_USERNAME=policyinsight
SPRING_DATASOURCE_PASSWORD=policyinsight

# Railway provides DATABASE_URL from the PostgreSQL plugin.
DATABASE_URL=postgresql://user:password@host:5432/database

GEMINI_API_KEY=replace-with-gemini-api-key
APP_TOKEN_SECRET=replace-with-a-long-random-secret
APP_AI_PROVIDER=mock
GEMINI_MODEL=gemini-1.5-flash

# Upload and retention defaults.
APP_UPLOAD_MAX_BYTES=10485760
APP_CLEANUP_ENABLED=true
APP_RETENTION_COMPLETED_DAYS=30
APP_RETENTION_FAILED_DAYS=7
APP_RETENTION_EXPIRED_SHARE_DAYS=0
APP_JOB_STALE_MINUTES=30
APP_CLEANUP_FIXED_DELAY_MS=3600000
