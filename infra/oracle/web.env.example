# Oracle web instance runtime env template
# Copy to /opt/policyinsight/web.env on the Oracle VM and replace placeholder values.

SPRING_PROFILES_ACTIVE=oracle
PORT=8080
APP_BASE_URL=http://<oracle-host-or-domain>:8080

# Postgres remains the active datasource for revamp phase 1.
DB_HOST=<postgres-host>
DB_PORT=5432
DB_NAME=policyinsight
DB_USER=postgres
DB_PASSWORD=<replace-with-secret>

# App/runtime secrets
APP_TOKEN_SECRET=<replace-with-secret>

# Oracle path defaults (hosting differences only)
APP_STORAGE_MODE=local
APP_MESSAGING_MODE=local
APP_PROCESSING_MODE=local
POLICYINSIGHT_WORKER_ENABLED=false

# Optional integrations (disabled by default for minimal path)
VERTEX_AI_ENABLED=false
DATADOG_ENABLED=false
